{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDatasources": ["nix"],
      "matchDepNames": ["nixpkgs", "nixpkgs-unstable", "home"],
      "versioning": "nixpkgs"
    }
  ]
}
